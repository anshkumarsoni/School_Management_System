# -------------------------------------------------------------
# LOCAL MYSQL DATABASE CONFIGURATION (EXAMPLE TEMPLATE)
# -------------------------------------------------------------
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_local_mysql_password
DB_NAME=Student

# -------------------------------------------------------------
# FLASK SESSION SECURITY
# -------------------------------------------------------------
FLASK_SECRET_KEY=your_generated_random_secret_key_here
SECRET_KEY=your_generated_random_secret_key_here

# -------------------------------------------------------------
# AIVEN CLOUD MYSQL DATABASE CONFIGURATION (REPLICA & SYNC)
# -------------------------------------------------------------
AIVEN_DB_HOST=your-mysql-service.aivencloud.com
AIVEN_DB_PORT=23236
AIVEN_DB_USER=avnadmin
AIVEN_DB_PASSWORD=your_aiven_cloud_password_here
AIVEN_DB_NAME=defaultdb
AIVEN_DB_SSL_MODE=REQUIRED
